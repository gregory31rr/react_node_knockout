# Copy to .env for local work. Real values per stage live in your host's settings, never in git.

PORT=3000
APP_URL=http://localhost:3000

# Leave DATABASE_URL empty to use the built-in SQLite file (local tries only).
# Production uses PostgreSQL: postgres://user:password@host:5432/db?sslmode=require
DATABASE_URL=
DATA_DIR=./data

# Fill the app with sample people and work on first start (sign in as greg@demo.test / demo1234)
SEED_DEMO=1

# Optional services
ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=
