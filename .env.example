# Copy to .env for local work. Real values per stage live in your host's settings, never in git.

PORT=3000
APP_URL=http://localhost:3000

# Leave DATABASE_URL empty to use the built-in SQLite file (local tries only).
# Production uses PostgreSQL: postgres://user:password@host:5432/db?sslmode=require
DATABASE_URL=
DATA_DIR=./data

# Fill the app with sample people and work on first start (sign in as greg@demo.test / demo1234)
SEED_DEMO=1

# Optional services
ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
TRANSCRIBE_API_KEY=
TRANSCRIBE_URL=
TRANSCRIBE_MODEL=

# Call recordings in file storage (production). Leave empty to keep them in the database (demo / small teams).
# DigitalOcean Spaces example: STORAGE_ENDPOINT=https://nyc3.digitaloceanspaces.com STORAGE_REGION=nyc3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_KEY=
STORAGE_SECRET=
